# Copy to .env for local development: cp .env.example .env
# Required: token from @BotFather on Telegram.
BOT_TOKEN=123456:your-telegram-bot-token

# Leave WEBHOOK_URL empty for local development (the bot uses long-polling).
# On Render, RENDER_EXTERNAL_URL is injected automatically -> webhook mode.
# WEBHOOK_URL=https://your-app.onrender.com

# Optional: max upload size in MB (Telegram bot hard limit is 50).
MAX_FILE_MB=49

# Cookies to bypass YouTube/Instagram bot checks.
# PREFERRED: point to cookies.txt FILES (e.g. Render Secret Files). This avoids
# huge environment variables that break Render's build ("argument list too
# long"). The bot also auto-detects /etc/secrets/{youtube_cookies,
# instagram_cookies,cookies}.txt without any env var.
# YOUTUBE_COOKIES_FILE=/etc/secrets/youtube_cookies.txt
# INSTAGRAM_COOKIES_FILE=/etc/secrets/instagram_cookies.txt
# COOKIES_FILE=/etc/secrets/cookies.txt
#
# Alternative (small cookies only): inline Netscape cookies.txt contents.
# COOKIES_TXT=
# YOUTUBE_COOKIES_TXT=
# INSTAGRAM_COOKIES_TXT=

# Optional outbound proxy for yt-dlp (e.g. residential proxy to avoid blocks).
# YTDLP_PROXY=http://user:pass@host:port
